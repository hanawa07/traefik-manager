# 환경 변수
.env
.env.local

# 로컬 백업 파일
docker-compose.yml.bak.*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# Node
node_modules/
.next/
out/

# DB
*.db
*.sqlite

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Traefik 동적 설정 (생성된 파일들)
traefik-config/dynamic/*.yml
traefik-config/.background-tasks.lock
traefik-config/.runtime/
# 정적 설정 파일은 추적
!traefik-config/dynamic/security-headers.yml
!traefik-config/dynamic/global-sensitive-paths.yml
!traefik-config/dynamic/public-auth-rate-limits.yml
!traefik-config/dynamic/smarthome-public-webhook.yml
!traefik-config/dynamic/traefik-manager-private-domain.yml
